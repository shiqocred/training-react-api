NODE_ENV=development
APP_NAME=Fiber Banking API
APP_PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiber_banking?sslmode=disable

# Auth bearer token ditandatangani memakai key Ed25519 dari tabel jwks.
AUTH_ISSUER=fiber-banking-api
ACCESS_TOKEN_TTL_HOURS=24

# Resend email untuk OTP forgot password.
# Jika kosong, OTP akan dicetak ke terminal untuk development.
RESEND_API_KEY=
EMAIL_FROM=noreply@sro.my.id
OTP_EXPIRES_MINUTES=10

# Argon2id password hashing.
ARGON_MEMORY=65536
ARGON_ITERATIONS=3
ARGON_PARALLELISM=2
ARGON_SALT_LENGTH=16
ARGON_KEY_LENGTH=32

# Seeder.
# Jika NODE_ENV=production, seeder hanya membuat admin dari env di bawah.
# Untuk non-production, seeder membuat data demo dan transaksi demo sekali saja.
SEED_MODE=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
