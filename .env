APP_NAME=Fiber Banking API
APP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mydb?sslmode=disable

# Auth bearer token ditandatangani memakai key Ed25519 dari tabel jwks.
AUTH_ISSUER=fiber-banking-api
ACCESS_TOKEN_TTL_HOURS=24

# Resend email untuk OTP forgot password.
# Jika kosong, OTP akan dicetak ke terminal untuk development.
RESEND_API_KEY=re_HeKiPPEb_4q5V5eDGuxinS257YTH1JAog
EMAIL_FROM=noreply@sro.my.id
OTP_EXPIRES_MINUTES=10

# Argon2id password hashing.
ARGON_MEMORY=65536
ARGON_ITERATIONS=3
ARGON_PARALLELISM=2
ARGON_SALT_LENGTH=16
ARGON_KEY_LENGTH=32
